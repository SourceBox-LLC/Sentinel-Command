# Frontend Environment Variables

# Auth provider: "clerk" (default, hosted multi-tenant SaaS) or "local"
# (self-hosted, single admin account, no Clerk at all). Must match the
# backend's AUTH_PROVIDER. See backend/.env.example and
# backend/scripts/hash_local_admin_password.py.
VITE_AUTH_PROVIDER=clerk

# Clerk Publishable Key (required when VITE_AUTH_PROVIDER=clerk)
# Get this from your Clerk Dashboard: https://clerk.com/
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Backend API URL
# Leave empty for development (uses Vite proxy)
# Set to your production API URL for deployment
VITE_API_URL=

# Local HLS streaming
# Set true to stream directly from CameraNode on localhost (bypasses backend proxy)
VITE_LOCAL_HLS=