# Frontend environment variables (copy to frontend/.env)

# Sign-in: "clerk" (hosted) or "local" (self-hosted, one admin account).
# Must match the backend's AUTH_PROVIDER (backend-rs/.env.example).
VITE_AUTH_PROVIDER=clerk

# Clerk publishable key (VITE_AUTH_PROVIDER=clerk), from the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Backend API URL. Leave empty in development: Vite proxies /api to
# http://localhost:8000. The production image serves the frontend from
# the backend itself, so it stays empty there too.
VITE_API_URL=

# Development only: true streams straight from a CameraNode on
# localhost:8080 instead of through the backend.
VITE_LOCAL_HLS=
