# SourceBox Sentinel — local-development env file.  Copy to .env and
# fill in the secrets.

# ── Ollama Cloud (the LLM) ────────────────────────────────────────
# Get a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=qwen3.5:cloud

# Bound on tool-call iterations per run.  10 is plenty for the
# surveillance flow; raise only if you're seeing legitimate runs
# truncated by the cap.
MAX_AGENT_ITERATIONS=10
MAX_TOKENS=2048

# ── Command Center (the master of pending runs) ─────────────────
# In local dev, point at your local backend (8000) or the prod URL.
# In production this is the Fly.io app URL of OpenSentry Command.
OPENSENTRY_API_BASE=http://localhost:8000

# Shared secret for both directions of agent ↔ CC traffic:
#   - CC signs wakeup webhooks with HMAC-SHA256 using this key
#   - agent sends this key in X-Sentinel-Agent-Key on /api/sentinel/runs/* calls
# MUST match SENTINEL_AGENT_KEY on the Command Center side.
# Generate a strong value: `python -c "import secrets; print(secrets.token_hex(32))"`
SENTINEL_AGENT_KEY=

# ── Multi-tenant MCP credential ──────────────────────────────────
# ONE shared bearer used for every org. Per-call org scoping happens
# at the MCP server via the X-Agent-Org-Override header — the
# processor sets this header to the current run's org_id before
# calling tools.
#
# MUST match SENTINEL_AGENT_MCP_KEY on the Command Center side.
# Generate a strong value: `python -c "import secrets; print(secrets.token_hex(32))"`
OPENSENTRY_MCP_AGENT_KEY=

# ── Webhook signature behaviour ──────────────────────────────────
# DEV-ONLY: set to "false" so `curl -X POST localhost:8080/` works
# without signing.  Production keeps this at "true" — see fly.toml.
WEBHOOK_VERIFY_SIGNATURE=false
