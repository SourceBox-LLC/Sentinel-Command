# Command Center — environment variables
#
# Copy to `.env` (next to docker-compose.yml for Compose, or in backend-rs/
# for `cargo run`) and fill in what your setup needs. Every variable is
# described in AGENTS.md › Configuration; this file is a starting point.
# The AI agent's own variables are in docs/SENTINEL_AGENT.md.

# ── Sign-in ──────────────────────────────────────────────────────────
# "clerk" (hosted, multi-tenant) or "local" (self-hosted: one admin
# account, no Clerk, no billing). Must match the frontend's
# VITE_AUTH_PROVIDER.
AUTH_PROVIDER=clerk

# Clerk (AUTH_PROVIDER=clerk). From the Clerk dashboard.
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
# Signing secret of the Clerk webhook endpoint. Unset, webhooks are refused.
CLERK_WEBHOOK_SECRET=

# Local auth (AUTH_PROVIDER=local).
#   APP_SECRET_KEY:             openssl rand -hex 32
#   LOCAL_ADMIN_PASSWORD_HASH:  sentinel-hash-password
#                               (`cargo run --bin sentinel-hash-password`, or
#                               `docker compose run --rm --no-deps app sentinel-hash-password`)
# Wrap the hash in SINGLE QUOTES: it contains `$`, which Docker Compose
# would otherwise expand, and the login would fail with no explanation.
APP_SECRET_KEY=
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD_HASH=
LOCAL_ADMIN_EMAIL=

# The address people open the dashboard at. It is the Clerk token
# audience the backend accepts, a CORS origin, and the base of every link
# in an email, so it must be the address a browser uses.
#   npm run dev beside cargo run:   http://localhost:5173
#   docker compose:                 http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Extra CORS origins, comma-separated (optional).
# CORS_ALLOWED_ORIGINS=

# Only behind your OWN reverse proxy (nginx, Caddy, Traefik): take the
# client address from X-Forwarded-For instead of the connection. Leave it
# unset when the port is reached directly, because then the header is the
# caller's own claim and believing it lets anyone dodge the login limit.
# The proxy must SET the header, not append to one the client sent.
# On Fly it is on by default; Fly's edge sets Fly-Client-IP itself.
# TRUST_PROXY_HEADERS=true

# ── Database ─────────────────────────────────────────────────────────
# SQLite or PostgreSQL. Unset, it is sqlite:///./sentinel.db.
#   sqlite:///./sentinel.db         a file beside the binary (three slashes)
#   sqlite:////data/sentinel.db     an absolute path (four slashes)
#   postgresql://user:pass@host:5432/db
# The driver is compiled in: `cargo run --features sqlite` for SQLite,
# plain `cargo run` for PostgreSQL. The Docker image has both builds and
# picks by this URL.
DATABASE_URL=postgresql://sentinel:sentinel@127.0.0.1:5432/sentinel

# Shared rate-limit counters (optional). Without it, counters are
# per process: fine on one machine.
REDIS_URL=

# ── Self-hosted extras (optional) ────────────────────────────────────
# A Sentinel licence key unlocks Sentinel AI, and cloud data-sync if the
# licence includes it. Leave blank to run with everything else unlocked.
SENTINEL_LICENSE_KEY=
# These two default to the hosted services; you normally leave them alone.
# SENTINEL_LICENSE_SERVICE_URL=https://sentinel-license.fly.dev
# SENTINEL_SYNC_SERVICE_URL=https://sentinel-sync.fly.dev

# ── Live video cache ─────────────────────────────────────────────────
# Segments kept per camera (CameraNode sends 1-second segments).
SEGMENT_CACHE_MAX_PER_CAMERA=60
# Ceiling across ALL cameras (384 MiB). Keep it well under the machine's
# RAM, or the OOM killer stops every stream at once.
SEGMENT_CACHE_MAX_TOTAL_BYTES=402653184
# Largest accepted segment and playlist.
SEGMENT_PUSH_MAX_BYTES=2097152
PLAYLIST_PUSH_MAX_BYTES=65536
# Run cache eviction every N playlist updates.
CLEANUP_INTERVAL=20

# ── Email (Resend, optional) ─────────────────────────────────────────
# Leave EMAIL_ENABLED=false in development: the worker logs
# "would have sent" instead of spending the Resend quota.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Must be on a Resend-verified domain. Alerts are no-reply by design.
EMAIL_FROM_ADDRESS=notifications@sentinel-command.com
EMAIL_FROM_NAME=Sentinel by SourceBox

# ── Error tracking (optional) ────────────────────────────────────────
# Unset, Sentry is off. ERROR log lines become Sentry events, so this is
# also what delivers the disk-critical alert.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Sentinel AI, first-party deployment only ─────────────────────────
# A self-hosted install doesn't need these: issue a per-org `osa_` key in
# the dashboard (MCP → Sentinel Agent Keys) and give it to your agent.
# SENTINEL_AGENT_KEY=
# SENTINEL_AGENT_MCP_KEY=
# SENTINEL_AGENT_WEBHOOK_URL=http://sentinel-command.flycast:8080/wakeup
