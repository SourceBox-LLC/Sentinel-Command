# Command Center — environment variables
#
# This file moved from `backend/` with the rewrite: `backend/` is the AI
# agent now, and the agent's own variables are documented in
# docs/SENTINEL_AGENT.md rather than here.

# Auth provider: "clerk" (default, hosted multi-tenant SaaS) or "local"
# (self-hosted, single admin account, no Clerk at all, no billing).
# Everything is unlocked except Sentinel AI — see SENTINEL_LICENSE_KEY
# below. Must match the frontend's VITE_AUTH_PROVIDER.
AUTH_PROVIDER=clerk

# Clerk Authentication (required when AUTH_PROVIDER=clerk)
# Get these from https://clerk.com/ dashboard
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_WEBHOOK_SECRET=

# ── Local (self-hosted) auth — only used when AUTH_PROVIDER=local ────
# APP_SECRET_KEY signs local session tokens (and, if set, unsubscribe
# links too) — generate a random 32+ byte string, e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`.
# LOCAL_ADMIN_PASSWORD_HASH is generated by the `sentinel-hash-password`
# binary (`cargo run --bin sentinel-hash-password`, or just the name on a
# deployed machine).  `openssl rand -hex 32` does for APP_SECRET_KEY.
APP_SECRET_KEY=
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD_HASH=
LOCAL_ADMIN_EMAIL=

# Sentinel AI license (optional, self-hosted only) — unlocks the AI agent
# feature, which has a real ongoing LLM cost regardless of who hosts the
# dashboard. Leave SENTINEL_LICENSE_KEY blank to run self-hosted with
# every OTHER feature unlocked and Sentinel AI simply unavailable.
# Purchase/issue a key against the separate Sentinel-License-Service.
SENTINEL_LICENSE_KEY=
SENTINEL_LICENSE_SERVICE_URL=https://sentinel-license.fly.dev

# Cloud data-sync (optional, self-hosted only) — mirrors this install's
# database to a hosted Postgres so a dead disk doesn't take your
# incident history with it. One-way: the local database stays the source
# of truth and the app works with no internet, so this is a backup, not a
# dependency.
#
# There is no separate key: sync is a second entitlement on the
# SENTINEL_LICENSE_KEY above, so an install whose licence lacks it
# simply never syncs and this URL is unused. Recovery is
# `sentinel-restore-from-cloud` — see docs/runbooks/DISASTER_RECOVERY.md.
SENTINEL_SYNC_SERVICE_URL=https://sentinel-sync.fly.dev

# The URL people open the dashboard at. It is the extra CORS origin AND
# the base of every link in a notification email, so it has to be the
# address a browser uses — not the API's.
#   * `npm run dev` beside `cargo run`:  http://localhost:5173
#   * docker compose (one origin):       http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database — a SQLite file or PostgreSQL. Unset, it is
# sqlite:///./sentinel.db, as it was for the Python tier.
#
#   sqlite:///./sentinel.db        a file beside the binary (relative)
#   sqlite:////data/sentinel.db    an absolute path (four slashes)
#   postgresql://user:pass@host:5432/db
#
# The driver is compiled in: `cargo run --features sqlite` for a SQLite
# URL, plain `cargo run` for PostgreSQL. The image carries both builds
# and picks by this URL, so under Docker there is nothing to choose.
# For a local PostgreSQL:
#
#   docker run -d --name sentinel-pg -p 5432:5432 \
#       -e POSTGRES_USER=sentinel -e POSTGRES_PASSWORD=sentinel \
#       -e POSTGRES_DB=sentinel postgres:16-alpine
#
# A `postgresql+psycopg://` URL is accepted too — the SQLAlchemy driver
# suffix is stripped — so an existing secret keeps working.
DATABASE_URL=postgresql://sentinel:sentinel@127.0.0.1:5432/sentinel

# Shared rate-limit counters. Without it the counters are per-process,
# which is safe on one machine and lets a caller round-robin past the
# limit on several.
REDIS_URL=

# In-memory HLS segment cache (live streaming)
# Max segments cached per camera (older ones evicted automatically)
# With 1s segments from CameraNode, 60 = ~60 second window
SEGMENT_CACHE_MAX_PER_CAMERA=60
# Max bytes accepted for a single pushed segment
SEGMENT_PUSH_MAX_BYTES=2097152
# Ceiling across ALL camera caches; oldest segments are evicted globally
# once it is passed. 384 MiB is the default and is sized for a 1 GB
# machine — it MUST stay well under physical RAM, or the kernel's OOM
# killer fires long before the cache's own eviction can.
SEGMENT_CACHE_MAX_TOTAL_BYTES=402653184
# Max bytes accepted for a pushed playlist
PLAYLIST_PUSH_MAX_BYTES=65536
# Run cache eviction every N playlist updates
CLEANUP_INTERVAL=20
# (INACTIVE_CAMERA_CLEANUP_HOURS and LOG_RETENTION_DAYS used to be listed
# here. Neither is read: caches are dropped 60s after a camera stops
# pushing, and log retention is per plan. See AGENTS.md › Configuration.)

# ── Email notifications (Resend) ─────────────────────────────────────
# EMAIL_ENABLED is the global kill-switch — leave false in local dev so
# the worker logs "would have sent" instead of burning the Resend quota.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# From MUST be on a Resend-verified sending domain. sentinel-command.com
# is verified (DKIM + SPF/Return-Path). No-reply by design — customers
# email support@sentinel-command.com directly, not by replying to alerts.
EMAIL_FROM_ADDRESS=notifications@sentinel-command.com
EMAIL_FROM_NAME=Sentinel by SourceBox

# ── Error tracking (optional) ────────────────────────────────────────
# In production the Fly Sentry extension injects this; unset, the whole
# integration is a no-op, which is what local dev wants. ERROR log lines
# become Sentry events and INFO/WARN become breadcrumbs, so this is also
# what delivers the disk-critical alert.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
